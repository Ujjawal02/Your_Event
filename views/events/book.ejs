<%layout('/layouts/boilerplate')%>

<div class="row">
  <div class="col col-8 offset-2">
    <h2>Book Event</h2>

    <form action="/events/<%= event._id %>/book" method="POST">
        <label for="form-label">Full Name</label>
        <input
        type="text"
        name="booking[fullName]"
        placeholder="Full Name"
        class="form-control"
        required
        >
        <label for="form-label">Email</label>
        <input
            type="email"
            name="booking[email]"
            placeholder="Email"
            class="form-control"
            required
        >
        <label for="form-label">Mobile Number</label>
        <input
            type="tel"
            name="booking[mobile]"
            placeholder="Mobile Number"
            class="form-control"
            required
        >
        <label for="form-label">No. Of Tickets</label>
        <input
            type="number"
            name="booking[quantity]"
            placeholder="No. of Ticktes, Price of 1 ticket : <%=event.price%>"
            min="1"
            class="form-control"
            required
        >
        <label for="form-select">Select Type of Ticket</label>
        <select
        name="booking[ticketType]"
        id="ticketType"
        class="form-select"
        required
        >
            <option value="" selected disabled>Choose a ticket type</option>
            <option value="General">🎟️ General</option>
            <option value="VIP">⭐ VIP</option>
            <option value="Premium">👑 Premium</option>
        </select>

        <button class="btn btn-outline-dark mt-3">Book Now</button>
    </form>
  </div>
</div>
